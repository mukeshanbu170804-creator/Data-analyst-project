    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/"
        },
        "id": "a1b27153",
        "outputId": "5cb7dbd2-2d04-4115-8054-9ea4a51726e0"
      },
      "source": [
        "# Convert important columns to numeric\n",
        "numeric_columns = [\n",
        "    \"Sales\",\n",
        "    \"Order Item Total\",\n",
        "    \"Order Profit Per Order\",\n",
        "    \"Order Item Discount Rate\"\n",
        "]\n",
        "\n",
        "for col in numeric_columns:\n",
        "    df[col] = pd.to_numeric(df[col], errors=\"coerce\")\n",
        "\n",
        "# Calculate KPIs\n",
        "gross_sales = df[\"Sales\"].sum()\n",
        "net_sales = df[\"Order Item Total\"].sum()\n",
        "total_profit = df[\"Order Profit Per Order\"].sum()\n",
        "\n",
        "profit_margin = (\n",
        "    total_profit / net_sales * 100\n",
        "    if net_sales != 0 else 0\n",
        ")\n",
        "\n",
        "average_discount = (\n",
        "    df[\"Order Item Discount Rate\"].mean() * 100\n",
        ")\n",
        "\n",
        "print(\"===== SUPPLY CHAIN PERFORMANCE =====\")\n",
        "print(f\"Gross Sales: ${gross_sales:,.2f}\")\n",
        "print(f\"Net Sales: ${net_sales:,.2f}\")\n",
        "print(f\"Total Recorded Profit: ${total_profit:,.2f}\")\n",
        "print(f\"Aggregate Profit Margin: {profit_margin:.2f}%\")\n",
        "print(f\"Average Discount Rate: {average_discount:.2f}%\")"
      ],
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
          "text": [
            "===== SUPPLY CHAIN PERFORMANCE =====\n",
            "Gross Sales: $36,784,734.31\n",
            "Net Sales: $33,054,402.04\n",
            "Total Recorded Profit: $3,966,902.97\n",
            "Aggregate Profit Margin: 12.00%\n",
            "Average Discount Rate: 10.17%\n"
          ]
        }
      ]
    },
