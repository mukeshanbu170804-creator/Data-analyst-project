        "outputId": "03c94358-ef31-4289-cfa5-f9eabc9ce803"
      },
      "source": [
        "df[\"Discount Band\"] = pd.cut(\n",
        "    df[\"Order Item Discount Rate\"],\n",
        "    bins=[-0.001, 0.05, 0.10, 0.20, 1.0],\n",
        "    labels=[\n",
        "        \"0–5%\",\n",
        "        \"5–10%\",\n",
        "        \"10–20%\",\n",
        "        \"Above 20%\"\n",
        "    ]\n",
        ")\n",
        "\n",
        "discount_analysis = df.groupby(\n",
        "    \"Discount Band\",\n",
        "    observed=False\n",
        ").agg(\n",
        "    Number_of_Items=(\"Order Item Discount Rate\", \"count\"),\n",
        "    Total_Sales=(\"Order Item Total\", \"sum\"),\n",
        "    Total_Profit=(\"Order Profit Per Order\", \"sum\")\n",
        ")\n",
        "\n",
        "print(\"Discount Analysis:\")\n",
        "display(discount_analysis)"
      ],
      "execution_count": null,
      "outputs": [
        {
          "output_type": "stream",
          "name": "stdout",
