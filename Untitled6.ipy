    {
      "cell_type": "code",
      "metadata": {
        "colab": {
          "base_uri": "https://localhost:8080/",
          "height": 1000
        },
        "id": "6ace81a9",
        "outputId": "59391ec2-5cfe-4b81-af24-d9670e99df70"
      },
      "source": [
        "# Market analysis\n",
        "market_analysis = df.groupby(\"Market\").agg(\n",
        "    Total_Sales=(\"Order Item Total\", \"sum\"),\n",
        "    Total_Profit=(\"Order Profit Per Order\", \"sum\"),\n",
        "    Number_of_Orders=(\"Order Customer Id\", \"nunique\")\n",
        ").sort_values(\n",
        "    by=\"Total_Sales\",\n",
        "    ascending=False\n",
        ")\n",
        "\n",
        "print(\"Market Performance:\")\n",
        "display(market_analysis)\n",
        "\n",
        "# Regional analysis\n",
        "region_analysis = df.groupby(\"Order Region\").agg(\n",
        "    Total_Sales=(\"Order Item Total\", \"sum\"),\n",
        "    Total_Profit=(\"Order Profit Per Order\", \"sum\"),\n",
        "    Number_of_Orders=(\"Order Customer Id\", \"nunique\")\n",
        ").sort_values(\n",
        "    by=\"Total_Profit\",\n",
        "    ascending=False\n",
        ")\n",
        "\n",
        "print(\"Regional Performance:\")\n",
        "display(region_analysis)"
