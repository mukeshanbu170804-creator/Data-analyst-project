      "source": [
        "customer_analysis = df.groupby(\"Customer Segment\").agg(\n",
        "    Total_Sales=(\"Order Item Total\", \"sum\"),\n",
        "    Total_Profit=(\"Order Profit Per Order\", \"sum\"),\n",
        "    Number_of_Orders=(\"Order Customer Id\", \"nunique\")\n",
        ").sort_values(\n",
        "    by=\"Total_Profit\",\n",
        "    ascending=False\n",
        ")\n",
        "\n",
        "print(\"Customer Segment Performance:\")\n",
        "display(customer_analysis)"
      ],
      "execution_count": null,
      "outputs": [
        {
