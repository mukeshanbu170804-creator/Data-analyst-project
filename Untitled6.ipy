      "source": [
        "kpi_summary = pd.DataFrame({\n",
        "    \"KPI\": [\n",
        "        \"Gross Sales\",\n",
        "        \"Net Sales\",\n",
        "        \"Total Recorded Profit\",\n",
        "        \"Aggregate Profit Margin\",\n",
        "        \"Average Discount Rate\",\n",
        "        \"Total Records\"\n",
        "    ],\n",
        "    \"Value\": [\n",
        "        gross_sales,\n",
        "        net_sales,\n",
        "        total_profit,\n",
        "        f\"{profit_margin:.2f}%\",\n",
        "        f\"{average_discount:.2f}%\",\n",
        "        len(df)\n",
        "    ]\n",
        "})\n",
        "\n",
        "display(kpi_summary)"
      ],
