      },
      "source": [
        "# Analyze product category performance\n",
        "category_analysis = df.groupby(\"Category Name\").agg(\n",
        "    Total_Sales=(\"Order Item Total\", \"sum\"),\n",
        "    Total_Profit=(\"Order Profit Per Order\", \"sum\"),\n",
        "    Total_Orders=(\"Order Customer Id\", \"count\")  # Using Order Customer Id to represent transaction counts\n",
        ").sort_values(\n",
        "    by=\"Total_Sales\",\n",
        "    ascending=False\n",
        ")\n",
        "\n",
        "print(\"Top 10 Product Categories by Net Sales:\")\n",
        "display(category_analysis.head(10))"
      ],
      "execution_count": null,
      "outputs": [
